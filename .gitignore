__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local configuration (contains credentials/IPs)
config.yaml
config/config.yaml
.env

# Downloaded artwork cache
cache/

# Local music metadata cache (artist/album/track ids and claims)
library/

# Unified media-data cache (mediadata.path in config.example.yaml)
mediadata/

# Backups of config/config.yaml made before each edit (see config_backup.py)
config/.config_backups/

# Derived-image cache files ImageCache.get_derived_path() writes next to
# the original (e.g. Pixoo/Ulanzi's LED-resized versions of a poster) -
# same {stem}_{16-hex-chars}.{ext} naming wherever the original lives
posters/*_????????????????.jpg
posters/*_????????????????.png

# Log files
logs/

# Folder output: mirrored artwork for whatever's currently playing
artwork/
pixoo_16/

# ADB keys for the Shield source (private key material)
adb_keys/

# Spotify OAuth token
spotify_cache/

# Manual artwork overrides (user-uploaded images)
overrides/

# idle.local: your own pictures (no trailing slash - likely a symlink to
# somewhere else on the host, e.g. an existing photo library, and a
# pattern with a trailing slash only matches real directories, not
# symlinks)
pictures

# Local Claude Code settings
.claude/settings.local.json

# Editor swap files
*.swp

# Local deploy script (host-specific rsync target)
deploy-vinyl-recognizer-rp4.sh

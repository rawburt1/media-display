# Copy this file to config.yaml and fill in your own values.

# How often (in seconds) to poll each enabled source for "now playing" info.
poll_interval_seconds: 5

# Source priority: when multiple sources are active at once, the first
# active source in this list wins.
priority:
- kodi
- appletv
- homeassistant
- youtube
- shield
- plex
- sonos
- vinyl
- spotify

# Idle wallpaper source priority - first one with pictures available wins;
# never mixed together. Local pictures first (fastest, no network), then
# Pexels, then Unsplash as a last resort (currently unreliable from here).
idle_priority:
- local
- pexels
- unsplash
idle_mode: priority

